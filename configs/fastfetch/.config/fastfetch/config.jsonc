{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "source": "arch",
        "color": {
            "1": "white"
        },
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "white",
            "title": "white"
        },
        "key": {
            "width": 10
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        {
            "type": "memory",
            "format": "{used} / {total}"
        }
    ]
}
