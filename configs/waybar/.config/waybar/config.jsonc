// -*- mode: jsonc -*-

{
    "name": "pinned",
    "layer": "top",
    "position": "top",

    "height": 36,
    "spacing": 4,

    "margin-left": 10,
    "margin-right": 10,
    "margin-top": 10,
    "margin-bottom": 0,

    "mode": "dock",
    "exclusive": true,

    "modules-left": [
        "group/power-menu",
        "group/workspace-dock"
    ],

    "modules-center": [
        "group/time-date"
    ],

    "modules-right": [
        "group/sound",
        "group/connections",
        "group/hardware",
        "group/display",
        "group/batteries"
    ],

    // =========================================================
    // Groups
    // =========================================================

    "group/power-menu": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "group/sysmenu"
        ]
    },

    "group/workspace-dock": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "hyprland/workspaces"
        ]
    },

    "group/time-date": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "clock",
            "custom/nightlight"
        ]
    },

    "group/sound": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "pulseaudio"
        ]
    },

    "group/connections": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "network",
            "bluetooth"
        ]
    },


    "group/hardware": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "custom/hardware-status"
        ]
    },

    "group/display": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "custom/display-mode"
        ]
    },

    "group/batteries": {
        "orientation": "inherit",
        "class": "bubble",
        "modules": [
            "custom/power-profile",
            "backlight",
            "battery"
        ]
    },

    // =========================================================
    // Workspaces and clock
    // =========================================================

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": ""
        },
        "disable-scroll": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "clock": {
        "format": "{:%H:%M   %A, %b %d}"
    },

    // =========================================================
    // Connectivity
    // =========================================================

    "network": {
        "format-wifi": "<span size='160%'>\uf1eb</span>",
        "format-disconnected": "<span size='160%'>\uf1eb</span>",
        "format-disabled": "<span size='160%'>&#xf092d;</span>",
        "format-ethernet": "<span size='160%'>\uf796</span>",

        "tooltip-format-wifi": "{essid}",
        "tooltip-format-ethernet": "Ethernet",
        "tooltip-format-disconnected": "Wi-Fi disconnected",
        "tooltip-format-disabled": "Wi-Fi disabled"
    },

    "bluetooth": {
        "format-connected": "<span size='120%'>\uf294</span>",
        "format-on": "<span size='120%'>\uf294</span>",
        "format-off": "<span size='130%'>&#xf00b2;</span>",
        "format-disabled": "<span size='130%'>&#xf00b2;</span>",

        "tooltip-format-connected": "Connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "• {device_alias}",
        "tooltip-format-enumerate-connected-battery": "• {device_alias}  ({device_battery_percentage}%)",

        "tooltip-format-on": "Bluetooth on\nNo devices connected",
        "tooltip-format-off": "Bluetooth off",
        "tooltip-format-disabled": "Bluetooth disabled"
    },

    // =========================================================
    // Hardware and power
    // =========================================================

    "backlight": {
        "format": "<span size='120%'>{icon}</span>",
	"tooltip-format": "Screen brightness",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "custom/hardware-status": {
        "format": "{text}",
        "return-type": "json",
        "exec": "~/dotfiles/scripts/hardware-status.sh",
        "interval": 5,
        "hide-empty-text": true,
        "tooltip": true
    },

    "custom/display-mode": {
        "format": "<span size='160%'>󰍹</span> <span rise='2000'>{text}</span>",
        "return-type": "json",
        "exec": "~/dotfiles/scripts/display-mode-select.sh --status",
        "interval": 10,
        "signal": 13,
        "on-click": "~/dotfiles/scripts/display-mode-select.sh",
        "tooltip": true
    },

    "custom/power-profile": {
        "format": "<span size='130%'>{text}</span>",
        "return-type": "json",
        "exec": "~/dotfiles/scripts/power-profile-select.sh --status",
        "interval": 5,
        "signal": 14,
        "on-click": "~/dotfiles/scripts/power-profile-cycle.sh",
        "on-click-right": "~/dotfiles/scripts/power-profile-select.sh",
        "hide-empty-text": true,
        "tooltip": true
    },

    "battery": {
        "format": "<span rise='3000'>{capacity}%</span> <span size='160%'>{icon}</span>",

        "format-charging": "<span rise='3000'>{capacity}%</span> <span size='160%'>{icon}</span> <span size='110%' rise='2000'></span>",
        "format-plugged": "<span rise='3000'>{capacity}%</span> <span size='160%'>{icon}</span> <span size='110%' rise='2000'></span>",
        "format-full": "<span rise='3000'>{capacity}%</span> <span size='160%'>{icon}</span> <span size='110%' rise='2000'></span>",

        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },

    //"power-profiles-daemon": {
    //    "format": "<span size='130%'>{icon}</span>",
    //    "tooltip": true,
    //    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    //    "format-icons": {
    //        "default": "\uf24e",
    //        "performance": "\uf135",
    //        "balanced": "\uf219",
    //        "power-saver": "\uf06c"
    //    }
    //},

    "pulseaudio": {
        "format": "<span rise='3000'>{volume}%</span> <span size='160%'>{icon}</span>",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                "",
                ""
            ]
        }
    },

    // =========================================================
    // Inline system menu
    // =========================================================

    "group/sysmenu": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "sysmenu-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/sysmenu",
            "custom/lock",
            "custom/sleep",
            "custom/exit",
            "custom/reboot",
            "custom/power"
        ]
    },

    "custom/sysmenu": {
        "format": "<span size='130%'>\uf0c9</span>",
        "tooltip": false
    },

    "custom/lock": {
        "format": "<span size='120%'>&#xf0341;</span>",
        "on-click": "hyprlock",
        "tooltip-format": "Lock"
    },

    "custom/sleep": {
        "format": "<span size='110%'>&#xf0904;</span>",
        "on-click": "hyprlock & sleep 1 && systemctl suspend",
        "tooltip-format": "Suspend"
    },

    "custom/exit": {
        "format": "<span size='130%'>&#xf08b;</span>",
        "on-click": "hyprctl dispatch exit",
        "tooltip-format": "Exit Hyprland"
    },

    "custom/reboot": {
        "format": "<span size='130%'>\uf021</span>",
        "on-click": "systemctl reboot",
        "tooltip-format": "Restart"
    },

    "custom/power": {
        "format": "<span size='130%'>\uf011</span>",
        "on-click": "systemctl poweroff",
        "tooltip-format": "Shutdown"
    },

    // =========================================================
    // Night light
    // =========================================================

    "custom/nightlight": {
        "format": "{icon}",
        "return-type": "json",

        "exec": "pgrep -x wlsunset >/dev/null && echo '{\"alt\": \"active\", \"tooltip\": \"Night Shift: ON\"}' || echo '{\"alt\": \"default\", \"tooltip\": \"Night Shift: OFF\"}'",

        "interval": "once",
        "signal": 12,

        "on-click": "~/dotfiles/scripts/nightlight-toggle.sh",

        "format-icons": {
            "active": "<span size='130%'>󰖔</span>",
            "default": "<span size='130%'>󰖙</span>"
        }
    }
}
